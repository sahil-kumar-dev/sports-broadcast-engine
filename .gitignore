```gitignore
# Dependency directories
node_modules/
venv/
.venv/
env/
.env

# Build outputs
dist/
build/
out/
.next/
.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/
.nyc_output/
```
